PORT=3001

# Add your key here to enable Gemini plan generation and photo diagnosis.
# Without it the app still works with the built-in agronomy rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000

# Optional: move the SQLite database and uploaded photos elsewhere.
# MASAI_DATA_DIR=./server/data
